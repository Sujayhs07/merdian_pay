# Copy this file to .env in the same folder (api/.env) and fill in real values.
# .env is already in .gitignore — never commit real secrets.

# Port the backend listens on. Optional — defaults to 8787 if unset.
PORT=8787

# Secret key for signing merchant JWT authentication tokens
JWT_SECRET=meridianpay_dev_jwt_secret_key_2026

# --- Circle Developer account (needed only for the Ethereum/CCTP completion step) ---
# Not required to run the Solana-only flow (Week 1-2). Create these at
# console.circle.com — use the sandbox/testnet environment, it's free.
# See crypto-worlds-fair-roadmap.md for the full setup steps.

# Your Circle sandbox API key
CIRCLE_API_KEY=

# Your registered entity secret (32-byte hex string) for Circle's
# Developer-Controlled Wallets. Generated + registered via the
# @circle-fin/developer-controlled-wallets SDK — see the roadmap doc.
CIRCLE_ENTITY_SECRET=

# The wallet set / wallet ID your backend will use to sign the Solana-side
# CCTP mint completion automatically. Fill this in once you've created a
# developer-controlled wallet on Solana Devnet via the Circle Console or SDK.
CIRCLE_SOLANA_WALLET_ID=

# --- Customer Invoice Email Delivery Configuration (Optional) ---
# Option A: Resend API (Recommended for modern web apps — https://resend.com)
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=invoices@yourdomain.com

# Option B: Standard SMTP (Gmail, Outlook, Amazon SES, SendGrid, Brevo)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

